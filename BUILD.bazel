# Mirrors c++/CMakeLists.txt's three capnp_generate_cpp() calls over
# schema/*.capnp.

load("@capnp-cpp//src/capnp:cc_capnp_library.bzl", "cc_capnp_library")

cc_capnp_library(
    name = "naja_common_capnp",
    srcs = ["schema/naja_common.capnp"],
    src_prefix = "schema",
    includes = ["schema"],
    visibility = ["//visibility:public"],
)

cc_capnp_library(
    name = "naja_nl_interface_capnp",
    srcs = ["schema/naja_nl_interface.capnp"],
    deps = [":naja_common_capnp"],
    src_prefix = "schema",
    includes = ["schema"],
    visibility = ["//visibility:public"],
)

cc_capnp_library(
    name = "naja_nl_implementation_capnp",
    srcs = ["schema/naja_nl_implementation.capnp"],
    deps = [":naja_common_capnp"],
    src_prefix = "schema",
    includes = ["schema"],
    visibility = ["//visibility:public"],
)
