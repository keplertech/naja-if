# Mirrors c++/CMakeLists.txt's three capnp_generate_cpp() calls over
# schema/*.capnp.

load("@capnp-cpp//src/capnp:cc_capnp_library.bzl", "cc_capnp_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_capnp_library(
    name = "naja_common_capnp",
    srcs = ["schema/naja_common.capnp"],
    src_prefix = "schema",
    includes = ["schema"],
    visibility = ["//visibility:public"],
)

cc_capnp_library(
    name = "naja_nl_interface_capnp",
    srcs = ["schema/naja_nl_interface.capnp"],
    deps = [":naja_common_capnp"],
    src_prefix = "schema",
    includes = ["schema"],
    visibility = ["//visibility:public"],
)

cc_capnp_library(
    name = "naja_nl_implementation_capnp",
    srcs = ["schema/naja_nl_implementation.capnp"],
    deps = [":naja_common_capnp"],
    src_prefix = "schema",
    includes = ["schema"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "naja_if_tests",
    srcs = [
        "c++/test/NajaIFTest0.cpp",
        "c++/test/NajaIFAttributesTest.cpp",
    ],
    defines = ['NAJA_IF_TEST_PATH=\\".\\"'],
    deps = [
        ":naja_nl_interface_capnp",
        ":naja_nl_implementation_capnp",
        "@capnp-cpp//src/capnp:capnp",
        "@capnp-cpp//src/kj:kj",
        "@googletest//:gtest_main",
    ],
)
