"""Native schema libraries for source builds and registry distribution.

Both CMake and Bazel generate C++ from schema/ in this checkout. Cap'n Proto
libraries and code-generation tools come from the Bazel dependency graph.
The release version is set in the registry's MODULE.bazel at publication time.
"""

module(
    name = "naja-if",
)

bazel_dep(name = "capnp-cpp", version = "1.4.0")

bazel_dep(name = "rules_cc", version = "0.2.25")

bazel_dep(name = "googletest", version = "1.17.0", dev_dependency = True)
